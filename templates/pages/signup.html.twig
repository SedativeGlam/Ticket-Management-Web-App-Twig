{% extends 'base.html.twig' %}

{% block body %}
<main class="font-display bg-background-light dark:bg-background-dark">
    <div class="relative flex min-h-screen w-full flex-col items-center justify-center bg-background-light dark:bg-background-dark p-6 pb-24 group/design-root">
        <div class="w-full max-w-md mx-auto">
            <div class="flex flex-col items-center mb-8">
                <div class="flex items-center justify-center h-16 w-16 bg-primary rounded-full mb-4">
                    <span class="material-symbols-outlined text-white text-4xl bg-[#4F46E5] p-3 rounded-full">
                        confirmation_number
                    </span>
                </div>
                <h1 class="text-slate-800 dark:text-slate-100 tracking-tight text-3xl font-bold leading-tight text-center font-display">
                    Get Started
                </h1>
                <p class="text-slate-600 dark:text-slate-400 text-base font-bold leading-normal pt-2 text-center font-display">
                    Create your account to start managing tickets.
                </p>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 p-3 rounded-lg text-white {% if label == 'success' %}bg-green-600{% else %}bg-red-600{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="w-full bg-white dark:bg-slate-900/50 p-8 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800">
                {% include 'components/signup/form.html.twig' with { formData: formData, errors: errors } %}
            </div>

            <p class="text-slate-600 dark:text-slate-400 text-sm font-normal leading-normal pt-6 text-center">
                Already have an account?
                <a href="{{ path('login') }}" class="font-semibold text-primary hover:underline">Sign In</a>
            </p>
        </div>

       
    </div>
</main>
{% endblock %}
